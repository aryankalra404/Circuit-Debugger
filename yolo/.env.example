# ── CircuitDoctor Python Backend Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Reka AI API key — get yours at https://platform.reka.ai
# Leave blank to disable Reka visual verification (YOLO-only mode still works).
REKA_API_KEY=your_reka_api_key_here
